def check_age(age):
    if not isinstance(age, (int, float)):
        raise ValueError("Вік повинен бути числом!")
    assert age >= 0, "Вік не може бути від'ємним!"
    assert age <= 120, "Вік не може перевищувати 120 років!"
    return age


def count_vowels(text: str) -> int:
    if not isinstance(text, str):
        raise ValueError("Аргумент має бути рядком")
    vowels = set("aeiouyаеєиіїоуюяAEIOUYАЕЄИІЇОУЮЯ")
    return sum(1 for char in text if char in vowels)


def get_user_rating():
    rating = input("Введіть вашу оцінку від 1 до 5: ")
    return f"Ваша оцінка: {rating}"


class Figure:
    def __init__(self, figure_type: str, length: float):
        if length < 0:
            raise ValueError("Від'ємна довжина!")
        if length == 0:
            raise ValueError("Нульова довжина!")

        valid_types = ["квадрат", "прямокутник", "трикутник"]
        if figure_type not in valid_types:
            raise ValueError("Невідомий тип фігури!")

        self.figure_type = figure_type
        self.length = length  # 

    @property
    def get_figure_type(self):
        return self.figure_type

    @property
    def get_figure_length(self):
        return self.length

    def get_angles(self):
        if self.figure_type in ["квадрат", "прямокутник"]:
            return 4
        elif self.figure_type == "трикутник":
            return 3
        return 0
